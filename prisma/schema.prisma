generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection (Supabase pgbouncer, port 6543) for the app…
  url      = env("DATABASE_URL")
  // …direct connection (port 5432) for migrations only.
  directUrl = env("DIRECT_URL")
}

model Subject {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String
  examDate  DateTime?
  topics    Topic[]
  createdAt DateTime  @default(now())
}

model Topic {
  id           String     @id @default(cuid())
  subjectId    String
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name         String
  notes        String?
  source       String     @default("SELF") // COLLEGE | SELF
  dateStudied  DateTime
  easeFactor   Float      @default(2.5)
  intervalDays Int        @default(0)
  repetitions  Int        @default(0)
  nextReview   DateTime
  status       String     @default("LEARNING") // LEARNING | REVIEWING | MASTERED | SUSPENDED
  questions    Question[]
  reviews      Review[]
  highlights   Highlight[] // book highlights promoted into this topic
  createdAt    DateTime   @default(now())
}

model Question {
  id      String  @id @default(cuid())
  topicId String
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  text    String
  answer  String?
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Review {
  id             String   @id @default(cuid())
  topicId        String
  topic          Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  reviewedAt     DateTime @default(now())
  rating         String // AGAIN | HARD | GOOD | EASY
  intervalBefore Int
  intervalAfter  Int
}

// ---------- Phase 2: DSA tracker (reuses lib/sm2.ts) ----------

model Problem {
  id           String           @id @default(cuid())
  title        String
  platform     String // LEETCODE | CODEFORCES | GFG | OTHER
  externalId   String? // e.g. "two-sum" slug
  url          String?
  difficulty   String // EASY | MEDIUM | HARD
  patterns     ProblemPattern[]
  notes        String? // the key insight, in my own words
  // SM-2 state — identical fields to Topic, reuses lib/sm2.ts
  easeFactor   Float            @default(2.5)
  intervalDays Int              @default(0)
  repetitions  Int              @default(0)
  nextReview   DateTime
  status       String           @default("LEARNING") // LEARNING | REVIEWING | MASTERED | SUSPENDED
  attempts     Attempt[]
  firstSolved  DateTime
  createdAt    DateTime         @default(now())
}

model Pattern {
  id       String           @id @default(cuid())
  name     String           @unique // "Sliding Window", "Monotonic Stack", ...
  problems ProblemPattern[]
}

model ProblemPattern {
  problemId String
  patternId String
  problem   Problem @relation(fields: [problemId], references: [id], onDelete: Cascade)
  pattern   Pattern @relation(fields: [patternId], references: [id], onDelete: Cascade)

  @@id([problemId, patternId])
}

model Attempt {
  id             String   @id @default(cuid())
  problemId      String
  problem        Problem  @relation(fields: [problemId], references: [id], onDelete: Cascade)
  attemptedAt    DateTime @default(now())
  outcome        String // SOLVED_CLEAN | SOLVED_STRUGGLED | NEEDED_HINT | LOOKED_UP_SOLUTION
  minutesTaken   Int?
  intervalBefore Int
  intervalAfter  Int
}

// ---------- Phase 2: Book reading tracker ----------

model Book {
  id         String           @id @default(cuid())
  title      String
  author     String
  category   String // TECHNICAL | NONFICTION | FICTION
  totalPages Int?
  status     String           @default("READING") // WANT_TO_READ | READING | FINISHED | ABANDONED
  startedAt  DateTime?
  finishedAt DateTime?
  rating     Int? // 1-5, set on finish
  sessions   ReadingSession[]
  highlights Highlight[]
  createdAt  DateTime         @default(now())
}

model ReadingSession {
  id      String   @id @default(cuid())
  bookId  String
  book    Book     @relation(fields: [bookId], references: [id], onDelete: Cascade)
  date    DateTime
  endPage Int // page I reached — pages read is derived from previous session
  minutes Int?
}

model Highlight {
  id      String  @id @default(cuid())
  bookId  String
  book    Book    @relation(fields: [bookId], references: [id], onDelete: Cascade)
  page    Int?
  text    String
  note    String?
  // OPTIONAL LINK: promoted into a study Topic for spaced repetition.
  topicId String?
  topic   Topic?  @relation(fields: [topicId], references: [id], onDelete: SetNull)
}

// ---------- Phase 2: Personal tech skills ----------

model Skill {
  id          String          @id @default(cuid())
  name        String // "React", "Prisma", "PyTorch", "Docker"
  category    String // FRONTEND | BACKEND | ML | DEVOPS | LANGUAGE | OTHER
  targetLevel Int // 1-5, where I want to be
  nextAction  String? // ONE concrete next step
  archived    Boolean         @default(false)
  snapshots   SkillSnapshot[]
  evidence    Evidence[]
  createdAt   DateTime        @default(now())
}

model SkillSnapshot {
  id      String   @id @default(cuid())
  skillId String
  skill   Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  level   Int // 1-5 self-assessment at this point in time
  note    String?
  takenAt DateTime @default(now())
}

model Evidence {
  id      String   @id @default(cuid())
  skillId String
  skill   Skill    @relation(fields: [skillId], references: [id], onDelete: Cascade)
  kind    String // PROJECT | COURSE | BOOK | ARTICLE | PROBLEM_SET
  label   String
  url     String?
  addedAt DateTime @default(now())
}

// ---------- Phase 3: Day planner ----------

model PlannerSettings {
  id               String   @id @default("singleton")
  wakeTime         String   @default("06:30") // local HH:mm
  sleepHours       Float    @default(7.5)
  preBufferMinutes Int      @default(60) // getting ready before leaving
  travelMinutes    Int      @default(60) // each way
  focusMode        String   @default("BALANCED") // BALANCED | EXAMS | CP | READING | SKILLS
  minBlockMinutes  Int      @default(25)
  maxBlockMinutes  Int      @default(90)
  breakMinutes     Int      @default(10)
  bufferPercent    Int      @default(20) // % of free time left deliberately unscheduled
  mealBlocks       Json     @default("[]") // [{label,start,minutes}]
  // Google Calendar is the output layer (widget + block-start notifications).
  gcalCalendarId   String?
  gcalRefreshToken String? // encrypted at rest with ENCRYPTION_KEY
  gcalSyncClasses  Boolean  @default(true)
  gcalLastSyncAt   DateTime?
  // Set when Google rejects the refresh token; drives the reconnect prompt.
  gcalAuthExpired  Boolean  @default(false)
  updatedAt        DateTime @updatedAt
}

model ClassSlot {
  id         String  @id @default(cuid())
  dayOfWeek  Int // 0=Sun .. 6=Sat
  startTime  String // "09:00"
  endTime    String // "10:00"
  label      String // "DAA Lecture", "IT Lab"
  subjectId  String?
  location   String?
  weekParity String  @default("EVERY") // EVERY | ODD | EVEN
  active     Boolean @default(true)

  @@index([dayOfWeek])
}

model CalendarException {
  id        String   @id @default(cuid())
  date      DateTime // date-only
  kind      String // HOLIDAY | NO_COLLEGE | CUSTOM_BUSY | EXAM
  label     String
  startTime String? // null = whole day
  endTime   String?

  @@index([date])
}

model PlannedBlock {
  id          String    @id @default(cuid())
  date        DateTime // date-only
  startTime   String // "16:30"
  endTime     String
  kind        String // SLEEP | GET_READY | TRAVEL | CLASS | MEAL | REVISION | DSA | READING | SKILL | CUSTOM | BREAK | BUFFER
  title       String
  // Deep-link payload so a block can open the right Retain screen.
  topicIds    String[]  @default([])
  problemIds  String[]  @default([])
  taskIds     String[]  @default([])
  bookId      String?
  skillId     String?
  locked      Boolean   @default(false) // manually placed — regeneration must not move it
  completed   Boolean   @default(false)
  completedAt DateTime?
  gcalEventId String?
  createdAt   DateTime  @default(now())

  @@index([date])
}

model ManualTask {
  id           String    @id @default(cuid())
  title        String
  estimateMins Int
  kind         String // DSA | READING | SKILL | STUDY | ADMIN
  dueDate      DateTime?
  priority     Int       @default(3) // 1 highest .. 5 lowest
  done         Boolean   @default(false)
  createdAt    DateTime  @default(now())
}
