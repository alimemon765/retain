generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Pooled connection (Supabase pgbouncer, port 6543) for the app…
  url      = env("DATABASE_URL")
  // …direct connection (port 5432) for migrations only.
  directUrl = env("DIRECT_URL")
}

model Subject {
  id        String    @id @default(cuid())
  name      String    @unique
  color     String
  examDate  DateTime?
  topics    Topic[]
  createdAt DateTime  @default(now())
}

model Topic {
  id           String     @id @default(cuid())
  subjectId    String
  subject      Subject    @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  name         String
  notes        String?
  source       String     @default("SELF") // COLLEGE | SELF
  dateStudied  DateTime
  easeFactor   Float      @default(2.5)
  intervalDays Int        @default(0)
  repetitions  Int        @default(0)
  nextReview   DateTime
  status       String     @default("LEARNING") // LEARNING | REVIEWING | MASTERED | SUSPENDED
  questions    Question[]
  reviews      Review[]
  createdAt    DateTime   @default(now())
}

model Question {
  id      String  @id @default(cuid())
  topicId String
  topic   Topic   @relation(fields: [topicId], references: [id], onDelete: Cascade)
  text    String
  answer  String?
}

model PushSubscription {
  id        String   @id @default(cuid())
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Review {
  id             String   @id @default(cuid())
  topicId        String
  topic          Topic    @relation(fields: [topicId], references: [id], onDelete: Cascade)
  reviewedAt     DateTime @default(now())
  rating         String // AGAIN | HARD | GOOD | EASY
  intervalBefore Int
  intervalAfter  Int
}
